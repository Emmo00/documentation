{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "x402go Documentation",
  "colors": {
    "primary": "#0D9488",
    "light": "#2DD4BF",
    "dark": "#0F766E"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "guides/how-it-works"]
          },
          {
            "group": "Integrations",
            "pages": ["guides/express", "guides/hono", "guides/nextjs"]
          },
          {
            "group": "Test and deploy",
            "pages": ["guides/celo-sepolia", "guides/security"]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/overview"
            ]
          }
        ]
      }
    ],
    "global": {
    }
  },
  "logo": {
    "light": "/logo/logo.svg",
    "dark": "/logo/logo.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open dashboard",
      "href": "https://x402go.online"
    },
    "links": [
      {
        "label": "Github",
        "href": "https://github.com/emmo00/x402go"
      }
    ]
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/emmo0x00",
      "github": "https://github.com/emmo00/x402go"
    }
  }
